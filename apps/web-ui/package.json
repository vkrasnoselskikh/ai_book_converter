{
  "name": "ai-book-converter-web-ui",
  "version": "1.0.0",
  "description": "AI Book Converter Single-Page Web Application",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.server.json src/server.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mistralai/mistralai": "^1.2.0",
    "@napi-rs/canvas": "^0.1.69",
    "@openai/agents": "^0.0.1-beta.6",
    "adm-zip": "^0.5.10",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "encoding": "^0.1.13",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.3.6",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "openai": "^4.33.0",
    "pdfjs-dist": "^6.0.227",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.20",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/adm-zip": "^0.5.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.70",
    "@types/react-dom": "^18.2.22",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "daisyui": "^5.0.0-beta.0",
    "postcss": "^8.4.38",
    "supertest": "^6.3.4",
    "tailwindcss": "^4.0.0-alpha.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5.4.3",
    "vite": "^5.2.2",
    "vitest": "^1.4.0"
  }
}
