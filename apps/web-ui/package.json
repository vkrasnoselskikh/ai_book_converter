{
  "name": "ai-book-converter-web-ui",
  "version": "1.0.0",
  "description": "AI Book Converter Single-Page Web Application",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.server.json src/server.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mistralai/mistralai": "^1.2.0",
    "@napi-rs/canvas": "^0.1.69",
    "@openai/agents": "^0.11.6",
    "adm-zip": "^0.5.10",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "daisyui": "^5.5.20",
    "dotenv": "^16.4.5",
    "encoding": "^0.1.13",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "openai": "^6.41.0",
    "pdfjs-dist": "^6.0.227",
    "prettier": "^3.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.0",
    "typeorm": "^1.0.0",
    "typescript": "^5.4.3",
    "unpdf": "^1.6.2",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/adm-zip": "^0.5.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.30",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "postcss": "^8.4.38",
    "supertest": "^7.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
